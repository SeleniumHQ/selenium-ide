{
  "name": "selenium-side-runner",
  "version": "4.1.0-beta.3",
  "private": false,
  "description": "Run Selenium IDE projects in cli",
  "repository": "https://github.com/SeleniumHQ/selenium-ide",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules",
    "start": "node dist/bin.js",
    "watch": "tsc --watch"
  },
  "bin": {
    "selenium-side-runner": "bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "runner.jest.config.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "keywords": [
    "selenium",
    "command",
    "line"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@seleniumhq/side-model": "workspace:*",
    "@seleniumhq/side-runtime": "workspace:*",
    "commander": "^15.0.0",
    "glob": "^14.0.3",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "jest-each": "^30.5.2",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "resolve-bin": "^1.0.1",
    "semver": "^7.8.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/resolve-bin": "^0.4.3",
    "@types/semver": "^7.8.0"
  }
}
