{
  "extends": "../../tsconfig.base.json",
  // webpack-cli loads webpack.config.ts with ts-node, which needs CommonJS
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node"
    }
  },
  "include": ["src/**/*"],
  "compilerOptions": {
    "jsx": "react",
    // webpack bundles the app, so resolve modules the way it does. This also
    // reads package "exports", which ESM-only packages like electron-store need.
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "api/*": ["./src/api/*"],
      "browser/*": ["./src/browser/*"],
      "main/*": ["./src/main/*"]
    },
    "outDir": "build",
    "rootDir": "src",
    "types": ["electron", "webpack-env"]
  },
  "references": [
    {
      "path": "../code-export-csharp-commons"
    },
    {
      "path": "../code-export-csharp-nunit"
    },
    {
      "path": "../code-export-csharp-xunit"
    },
    {
      "path": "../code-export-java-junit"
    },
    {
      "path": "../code-export-javascript-mocha"
    },
    {
      "path": "../code-export-python-pytest"
    },
    {
      "path": "../code-export-ruby-rspec"
    },
    {
      "path": "../side-api"
    },
    {
      "path": "../side-commons"
    },
    {
      "path": "../side-migrate"
    },
    {
      "path": "../side-model"
    },
    {
      "path": "../side-runtime"
    }
  ]
}
