{
  "description": "Selenium Record and Playback tool for ease of getting acquainted with Selenium WebDriver.",
  "manifest_version": 3,
  "name": "Selenium IDE",
  "version": "3.17.4",
  "version_name": "3.17.4",
  "minimum_chrome_version": "138",
  "homepage_url": "https://github.com/SeleniumHQ/selenium-ide",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon_menu16.png",
      "32": "icons/icon_menu32.png",
      "64": "icons/icon_menu64.png"
    },
    "default_title": "Selenium IDE"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "downloads",
    "webNavigation",
    "storage",
    "debugger",
    "userScripts"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "icons/icon_light128.png",
        "assets/prompt.js",
        "assets/indicator.js",
        "assets/highlight.css",
        "bootstrap.html",
        "indicator.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/vendor/global.js",
        "assets/vendor/selenium-browserdetect.js",
        "assets/atoms.js",
        "assets/polyfills.js",
        "assets/escape.js",
        "assets/playback.js",
        "assets/record.js"
      ],
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "assets/background.js",
    "scripts": [
      "assets/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{a6fd85ed-e919-4a43-a5af-8da18bda539f}",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
