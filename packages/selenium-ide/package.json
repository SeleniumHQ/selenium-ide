{
  "name": "selenium-ide",
  "version": "4.1.0-beta.2",
  "private": false,
  "description": "Selenium IDE electron app",
  "author": "Todd <tarsitodd@gmail.com>",
  "homepage": "http://github.com/SeleniumHQ/selenium-ide",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf build dist files node_modules tsconfig.tsbuildinfo",
    "start": "electron build/main-bundle.js",
    "dev": "cross-env SIDE_DEV=1 electron build/main-bundle.js",
    "build": "run-s build:webpack build:electron",
    "build:electron": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -mwl --publish never",
    "build:electron:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "build:electron:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -m --publish never",
    "build:webpack": "webpack",
    "install-app-deps": "electron-builder install-app-deps",
    "publish:electron:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -l --publish always",
    "publish:electron:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -m --publish always",
    "publish:electron:windows": "electron-builder -w --publish always",
    "release": "electron-builder",
    "serve": "cross-env SIDE_DEV=1 webpack serve",
    "watch": "webpack watch"
  },
  "bin": {
    "selenium-ide": "bin.js"
  },
  "sideEffects": false,
  "main": "build/main-bundle.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeleniumHQ/selenium-ide.git"
  },
  "bugs": {
    "url": "https://github.com/SeleniumHQ/selenium-ide/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "build": {
    "appId": "org.seleniumhq.selenium-ide",
    "asarUnpack": [
      "node_modules/electron-chromedriver/bin/chromedriver",
      "node_modules/electron-chromedriver/bin/chromedriver.exe",
      "node_modules/selenium-webdriver/bin/**",
      "node_modules/selenium-webdriver/common/**",
      "node_modules/selenium-webdriver/lib/logging.js"
    ],
    "files": [
      "**/build/**/*",
      "**/packages/*/dist/**/*.js",
      "!**/*.d.ts",
      "!**/selenium-ide/dist/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "productName": "Selenium IDE",
    "mac": {
      "target": {
        "target": "default",
        "arch": "universal"
      },
      "singleArchFiles": "*",
      "x64ArchFiles": "*",
      "mergeASARs": false,
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "artifactName": "Selenium-IDE-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "Selenium-IDE-${version}-${arch}.${ext}"
    },
    "win": {
      "publish": [
        {
          "provider": "github",
          "owner": "SeleniumHQ",
          "repo": "selenium-ide"
        }
      ],
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false
    },
    "linux": {
      "target": "AppImage"
    },
    "fileAssociations": [
      {
        "ext": "side",
        "name": "Selenium IDE 3 project",
        "role": "Editor"
      },
      {
        "ext": "sideproj",
        "name": "Selenium IDE project",
        "role": "Editor"
      }
    ]
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@seleniumhq/code-export-csharp-nunit": "workspace:*",
    "@seleniumhq/code-export-csharp-xunit": "workspace:*",
    "@seleniumhq/code-export-java-junit": "workspace:*",
    "@seleniumhq/code-export-javascript-mocha": "workspace:*",
    "@seleniumhq/code-export-python-pytest": "workspace:*",
    "@seleniumhq/code-export-ruby-rspec": "workspace:*",
    "@seleniumhq/side-api": "workspace:*",
    "@seleniumhq/side-commons": "workspace:*",
    "@seleniumhq/side-model": "workspace:*",
    "@seleniumhq/side-runtime": "workspace:*",
    "dnd-core": "^16.0.1",
    "electron-chromedriver": "^45.2.1",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "fs-extra": "^11.4.1",
    "lodash": "4.18.1",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.6",
    "react-resizable-panels": "^4.18.0",
    "scroll-into-view-if-needed": "^3.1.0",
    "selenium-webdriver": "^4.52.0",
    "side-code-export": "workspace:*",
    "v8-compile-cache": "^2.4.0"
  },
  "devDependencies": {
    "@medv/finder": "^4.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/webpack-env": "^1.18.8",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all2": "^9.0.4",
    "run-script-os": "^1.1.6",
    "source-map-loader": "^5.0.0",
    "source-map-support": "^0.5.21",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
